# Cấu hình chung cho Backend FastAPI
PROJECT_NAME="Hệ thống Quản lý Kho Thông minh AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Bảo mật & JWT
SECRET_KEY="kho-ai-secret-key-super-secure-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cấu hình Cơ sở dữ liệu (Mặc định SQLite cho demo nhanh)
DATABASE_URL="sqlite:///./warehouse.db"
# Nếu dùng PostgreSQL: postgresql://postgres:postgres@localhost:5432/warehouse_db

# Cấu hình Tích hợp Trí tuệ Nhân tạo (Google Gemini)
GEMINI_API_KEY=""
AI_PROVIDER="gemini"
AI_MODEL_NAME="gemini-1.5-flash"

# Cấu hình CORS (Cho phép React Vite localhost:5173)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
