graph LR
    %% Actors
    Admin["Quản trị viên<br/>(ADMIN)"]
    Keeper["Thủ kho<br/>(WAREHOUSE_KEEPER)"]
    Accountant["Kế toán kho<br/>(ACCOUNTANT)"]

    %% Boundaries / Subsystems
    subgraph Sub_Auth["1. Xác thực & Tài khoản"]
        UC_Login["Đăng nhập hệ thống<br/>/auth/login, /auth/token"]
        UC_Me["Tra cứu thông tin cá nhân<br/>/auth/me"]
        UC_Users["Quản lý người dùng & phân quyền<br/>POST /auth/users"]
    end

    subgraph Sub_MasterData["2. Quản lý Danh mục & Hàng hóa"]
        UC_CatView["Xem nhóm hàng<br/>GET /categories/"]
        UC_CatEdit["Thêm / Sửa nhóm hàng<br/>POST, PUT /categories/"]
        UC_CatDelete["Xóa nhóm hàng<br/>DELETE /categories/{id}"]
        UC_ProdView["Xem & Lọc hàng hóa, cảnh báo<br/>GET /products/"]
        UC_ProdEdit["Thêm / Sửa hàng hóa, Upload ảnh<br/>POST, PUT /products/"]
        UC_ProdDelete["Ngừng kinh doanh / Xóa hàng<br/>DELETE /products/{id}"]
        UC_SuppView["Xem đối tác nhà cung cấp<br/>GET /suppliers/"]
        UC_SuppEdit["Thêm / Sửa nhà cung cấp<br/>POST, PUT /suppliers/"]
        UC_SuppDelete["Ngừng hợp tác / Xóa NCC<br/>DELETE /suppliers/{id}"]
    end

    subgraph Sub_Transactions["3. Nhập kho & Xuất kho (ACID)"]
        UC_ImportCreate["Lập phiếu nhập kho<br/>POST /import-notes/"]
        UC_ImportCancel["Hủy phiếu nhập (Guard-check)<br/>POST /import-notes/{id}/cancel"]
        UC_ExportCreate["Lập phiếu xuất (CONFIRMED)<br/>POST /export-notes/"]
        UC_ExportShip["Bắt đầu giao (SHIPPING)<br/>POST /export-notes/{id}/ship"]
        UC_ExportComplete["Xác nhận hoàn tất (COMPLETED)<br/>POST /export-notes/{id}/complete"]
        UC_ExportCancel["Hủy đơn & Hoàn kho<br/>POST /export-notes/{id}/cancel"]
        UC_ExportDelete["Xóa phiếu chưa xuất<br/>DELETE /export-notes/{id}"]
    end

    subgraph Sub_LedgerReports["4. Thẻ kho, Kiểm kê & Báo cáo"]
        UC_LedgerView["Tra cứu Thẻ kho điện tử<br/>GET /stock-ledger/"]
        UC_LedgerExcel["Xuất Excel Thẻ kho (2 sheet)<br/>GET /stock-ledger/export-excel"]
        UC_StockAdjust["Điều chỉnh tồn kho kiểm kê<br/>POST /stock-ledger/adjust"]
        UC_ReportSummary["Xem Báo cáo Nhập-Xuất-Tồn<br/>GET /reports/inventory-summary"]
        UC_Dashboard["Xem KPI Dashboard & Cảnh báo<br/>GET /reports/dashboard, /reports/low-stock"]
    end

    subgraph Sub_AI["5. Trợ lý Trí tuệ Nhân tạo AI Copilot"]
        UC_AIMonthly["Báo cáo Nhập-Xuất-Tồn tháng<br/>GET /ai/monthly-report"]
        UC_AIRestock["Gợi ý nhập hàng tối ưu<br/>GET /ai/restock-suggestions"]
        UC_AIAnomalies["Nhận diện dị thường kho<br/>GET /ai/anomalies"]
        UC_AIOrder["Đề xuất đơn hàng xuất kho AI<br/>POST /ai/generate-order"]
        UC_AIAsk["Hỏi đáp Trợ lý kho (#SmartKho)<br/>POST /ai/ask"]
    end

